+#include "xla/service/get_outer_batch_value_simplifier.h"
+
+#include "xla/hlo/ir/dfs_hlo_visitor_with_default.h"
+#include "xla/service/hlo_creation_utils.h"
+#include "xla/hlo/ir/hlo_instruction.h"
