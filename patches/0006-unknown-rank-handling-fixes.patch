+class DynExpr {
+ public:
+  virtual ~DynExpr() = default;
+  virtual void print(xla::Printer* printer) const = 0;
+  virtual void to_proto(xla::ExpressionProto* proto) const = 0;
+  virtual bool is_constant() const = 0;
