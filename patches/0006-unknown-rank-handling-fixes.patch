+    if (rhs->get_all_ids().size() == 1) {
+      // (c + A) = x <=> A = x - c => solve A = y with y = x + c
+      return rhs->solve(x + lhs->get_val());
+    }
+    // No solution
+    return -1;
+  }
+
+  DynExpr* s() override;
+
+  ~Sub() {
+    delete lhs;
+    delete rhs;
+  }
